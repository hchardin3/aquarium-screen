{
  "name": "aquarium-screen",
  "version": "0.1.0",
  "private": true,
  "description": "Realistic live aquarium wallpaper for Ubuntu (X11/GNOME), built with Electron + Three.js",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "npm run build && electron .",
    "electron:dev": "VITE_DEV_URL=http://localhost:5173 electron .",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "license": "MIT",
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^44.5.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "vite": "^8.3.1"
  }
}
